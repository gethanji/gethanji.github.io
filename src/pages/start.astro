<script is:inline>
(() => { let choice='system'; try { choice=localStorage.getItem('hanji-theme')||'system'; } catch {} const media=matchMedia('(prefers-color-scheme:dark)'); const apply=()=>{document.documentElement.style.colorScheme=choice==='light'||choice==='dark'?choice:media.matches?'dark':'light';}; apply(); media.addEventListener('change',apply); })();
