---
import SEO from '../components/SEO.astro';
import knowledgeCSS from '../styles/knowledge-base.css?url';
import labCSS from '../styles/lab-base.css?url';
import trackerCSS from '../styles/tracker-base.css?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { dictionary } from '../data/site';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/motion.css';
import '../styles/paper-motion.css';
import '../styles/site-chrome.css';
import '../styles/knowledge-compat.css';
import '../styles/theme.css';
import '../styles/editorial-system.css';
const {lang,page} = Astro.props;
const ui = dictionary(lang).ui;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <style is:inline>@view-transition{navigation:auto}@media(prefers-reduced-motion:reduce){@view-transition{navigation:none}}</style>
  <script is:inline>
    (() => {
      const root = document.documentElement;
      root.dataset.js = 'true';
      // Native transitions may be skipped for redirects, history or a slow load.
      // Their rejected ready promise must not become an unhandled page error.
      for (const name of ['pageswap','pagereveal']) addEventListener(name, event => {
        event.viewTransition?.ready.catch(() => {});
      });
      const internal = document.referrer && new URL(document.referrer).origin === location.origin;
      const restored = performance.getEntriesByType('navigation')[0]?.type === 'back_forward';
      if (location.hash || internal || restored) root.dataset.entryStatic = 'true';
      // Resolve language before the body can paint; explicit localized links win.
      const supported = ['en','ko','de','ja','fr'];
      const detected = (navigator.languages || [navigator.language]).map(tag => tag.toLowerCase().split('-')[0]).find(lang => supported.includes(lang)) || 'en';
      let language = 'system';
      try { const saved = localStorage.getItem('hanji-language'); if (['system',...supported].includes(saved)) language = saved; } catch {}
      const target = language === 'system' ? detected : language;
      if (!/^\/(ko|de|ja|fr)\//.test(location.pathname) && !internal && root.lang !== target) {
        const suffix = location.pathname === '/' ? '/lab/' : location.pathname;
        location.replace('/' + target + suffix + location.search + location.hash);
      }
      let choice = 'system';
      try { const saved = localStorage.getItem('hanji-theme'); if (['light','dark','system'].includes(saved)) choice = saved; } catch {}
      document.documentElement.dataset.themeChoice = choice;
      document.documentElement.dataset.theme = choice === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : choice;
    })();
  </script>
  <SEO lang={lang} page={page} />
  <link rel="icon" href="/hanji-mark.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#f9faf6" />
  <link rel="stylesheet" href={page==='knowledge'?knowledgeCSS:page==='tracker'?trackerCSS:labCSS} />

  <noscript><style>.media-status{position:static;background:none;border:0;padding:16px}.media-status small,.capture-tabs{display:none}.capture[hidden]{display:block}</style></noscript>
</head>
<body class:list={[page==='knowledge'?'knowledge-family':page==='tracker'?'tracker tracker-v3':'lab lab-v2 brand-v3']} data-product={page}>
  <a class="skip" href="#main">{ui.skip}</a>
  <SiteHeader lang={lang} page={page} />
  <main id="main" class={page==='knowledge'?'wrap':undefined}><slot /></main>
  <SiteFooter lang={lang} />
<script>import '../scripts/paper-tilt';
 import '../scripts/theme';
 import '../scripts/page-motion';
 for(const link of document.querySelectorAll<HTMLAnchorElement>('[data-quick-start]'))link.addEventListener('click',()=>document.getElementById('get-started')?.focus({preventScroll:true}));
</script>
</body>
</html>
