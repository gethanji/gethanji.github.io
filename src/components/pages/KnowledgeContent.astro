---
import QuickStart from '../QuickStart.astro';
import { dictionary, localHref } from '../../data/site';
import KnowledgeHero from '../illustrations/KnowledgeHero.astro';
const { lang } = Astro.props;
const copy = dictionary(lang).knowledge;
---

 <section class="hero" aria-labelledby="hero-heading">
  <div class="hero-intro">
  <div class="hero-top"><p class="eyebrow">{copy["hero.eyebrow.1.text0"]}</p></div>
  <h1 id="hero-heading"><span>{copy["hero.span.1.text0"]}</span><em>{copy["hero.em.1.text0"]}</em></h1>
  <div class="hero-bottom"><div class="hero-message"><p class="lede">{copy["hero.lede.1.text0"]}</p><ul class="hero-keywords"><li>{copy["hero.li.1.text0"]}</li><li>{copy["hero.li.2.text0"]}</li><li>{copy["hero.li.3.text0"]}</li></ul><div class="actions"><div class="action-row"><a class="button" data-quick-start href="#get-started">{dictionary(lang).onboarding.cta}</a><button type="button" class="button button-quiet" id="agent-cta" aria-expanded="false" aria-controls="agent-command">{copy["hero.agent-cta.1.text0"]}</button></div><div class="agent-command" id="agent-command" hidden><code id="agent-command-text">{copy["hero.agent-command-text.1.text0"]}</code><span class="agent-command-note" id="agent-command-note" role="status" aria-live="polite">{copy["hero.agent-command-note.1.text0"]}</span></div></div></div><KnowledgeHero copy={copy} lang={lang} /></div>
  <a class="hero-explore" href="#demo">{copy["hero.hero-explore.1.text0"]}</a>
  </div>
  <div id="demo" class="product-stage" aria-label={copy["hero.demo.1.aria-label"]}>
   <div class="stage-bar"><p class="stage-label">{copy["hero.stage-label.1.text0"]}</p><div class="tabs" role="tablist" aria-label={copy["hero.tabs.1.aria-label"]}><button id="people-tab" role="tab" aria-selected="true" aria-controls="people-view" tabindex="0">{copy["hero.people-tab.1.text0"]}</button><button id="agent-tab" role="tab" aria-selected="false" aria-controls="agent-view" tabindex="-1">{copy["hero.agent-tab.1.text0"]}</button></div></div>
   <div class="workspace" id="people-view" role="tabpanel" aria-labelledby="people-tab">
    <aside class="sidebar" aria-label={copy["hero.sidebar.1.aria-label"]}><div class="workspace-brand"><img src="/hanji-mark.svg" alt={copy["hero.img.2.alt"]} />{copy["hero.workspace-brand.1.text1"]}<span>{copy["hero.span.6.text0"]}</span></div><div class="search">{copy["hero.search.1.text0"]}<span>{copy["hero.span.7.text0"]}</span></div><div class="side-label">{copy["hero.side-label.1.text0"]}</div><div class="side-item"><i>{copy["hero.i.7.text0"]}</i>{copy["hero.side-item.1.text1"]}</div><div class="side-item"><i>{copy["hero.i.8.text0"]}</i>{copy["hero.side-item.2.text1"]}<span id="side-count">{copy["hero.side-count.1.text0"]}</span></div><div class="side-label">{copy["hero.side-label.2.text0"]}</div><div class="side-item active"><i>{copy["hero.i.9.text0"]}</i>{copy["hero.side-item.3.text1"]}</div><div class="side-item"><i>{copy["hero.i.10.text0"]}</i>{copy["hero.side-item.4.text1"]}</div><div class="side-item"><i>{copy["hero.i.11.text0"]}</i>{copy["hero.side-item.5.text1"]}</div><div class="side-label">{copy["hero.side-label.3.text0"]}</div><div class="side-item"><i>{copy["hero.i.12.text0"]}</i>{copy["hero.side-item.6.text1"]}</div><div class="side-item"><i>{copy["hero.i.13.text0"]}</i>{copy["hero.side-item.7.text1"]}</div></aside>
    <article class="doc"><div class="doc-top"><span>{copy["hero.span.8.text0"]}</span></div><div class="doc-body"><h3>{copy["hero.h3.2.text0"]}</h3><p class="byline" id="byline">{copy["hero.byline.1.text0"]}</p><div class="doc-prose"><p class="demo-summary">{copy["hero.demo-summary.1.text0"]}</p><div class="demo-outline"><span>{copy["hero.span.9.text0"]}</span><span>{copy["hero.span.10.text0"]}</span><span>{copy["hero.span.11.text0"]}</span></div><h4>{copy["hero.h4.1.text0"]}</h4><ul class="demo-list"><li>{copy["hero.li.4.text0"]}</li><li>{copy["hero.li.5.text0"]}</li></ul><h4>{copy["hero.h4.2.text0"]}</h4><p>{copy["hero.p.1.text0"]}</p><p id="merged-line" hidden><mark>{copy["hero.mark.1.text0"]}</mark></p></div></div></article>
    <aside class="proposal" aria-label={copy["hero.proposal.1.aria-label"]}><div class="proposal-label"><span>{copy["hero.span.12.text0"]}</span><span class="badge" id="proposal-badge">{copy["hero.proposal-badge.1.text0"]}</span></div><div class="diff"><div class="addition">{copy["hero.addition.1.text0"]}</div></div><button class="merge" id="merge">{copy["hero.merge.1.text0"]}</button></aside>
   </div>
   <div class="terminal" id="agent-view" role="tabpanel" aria-labelledby="agent-tab" hidden><div class="terminal-label">{copy["hero.terminal-label.1.text0"]}</div><pre><span class="prompt">{copy["hero.prompt.1.text0"]}</span>{copy["hero.pre.1.text1"]}<span class="output">{copy["hero.output.1.text0"]}<span id="agent-added" hidden>{copy["hero.agent-added.1.text0"]}</span></span></pre><p class="terminal-caption">{copy["hero.terminal-caption.1.text0"]}</p></div>
   <div class="stage-foot"><span id="demo-status" role="status" aria-live="polite">{copy["hero.demo-status.1.text0"]}</span><button class="reset" id="reset" hidden>{copy["hero.reset.1.text0"]}</button><span class="branch">{copy["hero.branch.1.text0"]}</span></div>
  </div>
 </section>
 <QuickStart lang={lang} product="knowledge" />
 <section class="story" id="writing" aria-labelledby="writing-heading">
  <div class="story-head"><div><p class="section-index">{copy["writing.section-index.1.text0"]}</p><h2 id="writing-heading">{copy["writing.writing-heading.1.text0"]}<br /><em>{copy["writing.em.1.text0"]}</em></h2></div><div class="story-copy"><p>{copy["writing.p.1.text0"]}</p></div></div>
  <div class="flow" aria-label={copy["writing.flow.1.aria-label"]}><div class="flow-panel"><div class="flow-kicker"><span>{copy["writing.span.1.text0"]}</span><span>{copy["writing.span.2.text0"]}</span></div><p class="flow-quote">{copy["writing.flow-quote.1.text0"]}<del>{copy["writing.del.1.text0"]}</del> <ins>{copy["writing.ins.1.text0"]}</ins>{copy["writing.flow-quote.1.text2"]}<br />{copy["writing.flow-quote.1.text3"]}</p><p class="flow-note">{copy["writing.flow-note.1.text0"]}</p></div><div class="flow-arrow" aria-hidden="true">{copy["writing.flow-arrow.1.text0"]}</div><div class="flow-panel git-panel"><div class="flow-kicker"><span>{copy["writing.span.3.text0"]}</span><span>{copy["writing.span.4.text0"]}</span></div><pre><span class="minus">{copy["writing.minus.1.text0"]}</span>
<span class="plus">{copy["writing.plus.1.text0"]}</span></pre><p class="flow-note">{copy["writing.flow-note.2.text0"]}</p></div></div>
  <div class="story-bottom"><a class="text-link" href="https://gethanji.github.io/docs/handbook/product/byte-fidelity/">{copy["writing.text-link.1.text0"]}</a></div>
 </section>

 <section class="review-section chapter" id="review" aria-labelledby="review-heading"><div class="story-head"><div><p class="section-index">{copy["review.section-index.1.text0"]}</p><h2 id="review-heading">{copy["review.review-heading.1.text0"]}<br /><em>{copy["review.em.1.text0"]}</em></h2></div><p class="story-copy">{copy["review.story-copy.1.text0"]}</p></div><div class="review-stage"><div class="review-row"><span class="review-who">{copy["review.review-who.1.text0"]}</span><span class="review-title">{copy["review.review-title.1.text0"]}</span><span class="review-weight">{copy["review.review-weight.1.text0"]}</span></div><p class="review-note">{copy["review.review-note.1.text0"]}</p><div class="review-diff"><span class="d-add">{copy["review.d-add.1.text0"]}</span><span class="d-add">{copy["review.d-add.2.text0"]}</span></div></div></section>
 <section class="no-model chapter" id="no-model" aria-labelledby="model-heading"><div class="no-model-top"><p class="section-index">{copy["no-model.section-index.1.text0"]}</p><span class="small-label">{copy["no-model.small-label.1.text0"]}</span></div><div class="no-model-grid"><div class="zero" aria-label={copy["no-model.zero.1.aria-label"]}>{copy["no-model.zero.1.text0"]}<span aria-hidden="true">{copy["no-model.span.1.text0"]}</span></div><div class="no-model-copy"><h2 id="model-heading">{copy["no-model.model-heading.1.text0"]}<br /><em>{copy["no-model.em.1.text0"]}</em></h2><p>{copy["no-model.p.1.text0"]}</p><p>{copy["no-model.p.2.text0"]}</p></div></div><div class="zero-facts"><span><b>{copy["no-model.b.1.text0"]}</b>{copy["no-model.span.2.text1"]}</span><span><b>{copy["no-model.b.2.text0"]}</b>{copy["no-model.span.3.text1"]}</span><span><b>{copy["no-model.b.3.text0"]}</b>{copy["no-model.span.4.text1"]}</span></div><a class="agent-note" href="https://gethanji.github.io/docs/llms.txt"><span><span class="small-label">{copy["no-model.small-label.2.text0"]}</span>{copy["no-model.span.5.text1"]}</span><span class="mono">{copy["no-model.mono.1.text0"]}</span></a></section>
 <section class="permission-section chapter" id="permissions" aria-labelledby="permission-heading">
  <div class="story-head"><div><p class="section-index">{copy["permissions.section-index.1.text0"]}</p><h2 id="permission-heading">{copy["permissions.permission-heading.1.text0"]}<br /><em>{copy["permissions.em.1.text0"]}</em></h2></div><div class="story-copy"><p>{copy["permissions.p.1.text0"]}</p></div></div>
  <div class="permission-demo" aria-label={copy["permissions.permission-demo.1.aria-label"]}>
   <div class="permission-controls"><div class="identity-picker" role="group" aria-label={copy["permissions.identity-picker.1.aria-label"]}><button type="button" data-person="ada" aria-pressed="true"><span class="identity-avatar">{copy["permissions.identity-avatar.1.text0"]}</span><span>{copy["permissions.span.1.text0"]}<small>{copy["permissions.small.1.text0"]}</small></span></button><button type="button" data-person="remy" aria-pressed="false"><span class="identity-avatar">{copy["permissions.identity-avatar.2.text0"]}</span><span>{copy["permissions.span.2.text0"]}<small>{copy["permissions.small.2.text0"]}</small></span></button><button type="button" data-person="agent" aria-pressed="false"><span class="identity-avatar machine">{copy["permissions.identity-avatar.3.text0"]}</span><span>{copy["permissions.span.3.text0"]}<small>{copy["permissions.small.3.text0"]}</small></span></button></div><p class="interaction-hint">{copy["permissions.interaction-hint.1.text0"]}</p></div>
   <div class="permission-tree"><div class="tree-header"><span>{copy["permissions.span.4.text0"]}</span><span id="visible-count">{copy["permissions.visible-count.1.text0"]}</span></div><div class="tree-pages" id="tree-pages"><div class="tree-page" data-access="ada remy agent"><span class="file-icon" aria-hidden="true"></span><span>{copy["permissions.span.5.text0"]}<small>{copy["permissions.small.4.text0"]}</small></span><span class="access-label">{copy["permissions.access-label.1.text0"]}</span></div><div class="tree-page" data-access="ada remy agent"><span class="file-icon" aria-hidden="true"></span><span>{copy["permissions.span.6.text0"]}<small>{copy["permissions.small.5.text0"]}</small></span><span class="access-label">{copy["permissions.access-label.2.text0"]}</span></div><div class="tree-page" data-access="ada remy"><span class="file-icon" aria-hidden="true"></span><span>{copy["permissions.span.7.text0"]}<small>{copy["permissions.small.6.text0"]}</small></span><span class="access-label">{copy["permissions.access-label.3.text0"]}</span></div><div class="tree-page" data-access="ada"><span class="file-icon" aria-hidden="true"></span><span>{copy["permissions.span.8.text0"]}<small>{copy["permissions.small.7.text0"]}</small></span><span class="access-label">{copy["permissions.access-label.4.text0"]}</span></div></div><p class="permission-status" id="permission-status" role="status" aria-live="polite">{copy["permissions.permission-status.1.text0"]}</p></div>
  </div>
  <p class="fine-print">{copy["permissions.fine-print.1.text0"]}</p>
 </section>
 <section class="collaboration-section chapter" aria-labelledby="collaboration-heading">
  <div class="story-head"><div><p class="section-index">{copy["collaboration-section.section-index.1.text0"]}</p><h2 id="collaboration-heading">{copy["collaboration-section.collaboration-heading.1.text0"]}<br /><em>{copy["collaboration-section.em.1.text0"]}</em></h2></div><div class="story-copy"><p>{copy["collaboration-section.p.1.text0"]}</p></div></div>
  <div class="margin-demo"><div class="margin-page"><span class="small-label">{copy["collaboration-section.small-label.1.text0"]}</span><p><button type="button" class="annotated" id="comment-trigger" aria-expanded="false" aria-controls="margin-thread">{copy["collaboration-section.comment-trigger.1.text0"]}<span class="comment-count" aria-hidden="true">{copy["collaboration-section.comment-count.1.text0"]}</span></button></p><span class="interaction-hint">{copy["collaboration-section.interaction-hint.1.text0"]}</span></div><div class="margin-side"><div class="margin-idle" id="margin-idle"><span class="margin-line" aria-hidden="true"></span><p>{copy["collaboration-section.p.3.text0"]}<br /><em>{copy["collaboration-section.em.2.text0"]}</em></p></div><div class="margin-thread" id="margin-thread" hidden><div class="thread-top"><span>{copy["collaboration-section.span.1.text0"]}</span><button type="button" id="close-comment" aria-label={copy["collaboration-section.close-comment.1.aria-label"]}>{copy["collaboration-section.close-comment.1.text0"]}</button></div><div class="comment-item"><span class="identity-avatar">{copy["collaboration-section.identity-avatar.1.text0"]}</span><div><strong>{copy["collaboration-section.strong.1.text0"]}<small>{copy["collaboration-section.small.1.text0"]}</small></strong><p>{copy["collaboration-section.p.4.text0"]}</p></div></div><div class="comment-item"><span class="identity-avatar">{copy["collaboration-section.identity-avatar.2.text0"]}</span><div><strong>{copy["collaboration-section.strong.2.text0"]}<small>{copy["collaboration-section.small.2.text0"]}</small></strong><p>{copy["collaboration-section.p.5.text0"]}</p></div></div><span class="thread-foot">{copy["collaboration-section.thread-foot.1.text0"]}</span></div></div></div>
  <div class="margin-caption"><p>{copy["collaboration-section.p.6.text0"]}</p><a class="text-link" href="https://gethanji.github.io/docs/handbook/guide/comments/">{copy["collaboration-section.text-link.1.text0"]}</a></div>
  <div class="activity-example"><div><span class="small-label">{copy["collaboration-section.small-label.2.text0"]}</span><p>{copy["collaboration-section.p.7.text0"]}</p></div><div class="activity-chart"><div class="activity-legend"><span><i></i>{copy["collaboration-section.span.2.text1"]}</span><span><i></i>{copy["collaboration-section.span.3.text1"]}</span></div><div class="activity-bars" id="activity-bars" role="img" aria-label={copy["collaboration-section.activity-bars.1.aria-label"]}></div><div class="activity-axis"><span>{copy["collaboration-section.span.4.text0"]}</span><span>{copy["collaboration-section.span.5.text0"]}</span></div><p>{copy["collaboration-section.p.8.text0"]}</p></div></div>
 </section>

 <section class="compare-section chapter" id="compare" aria-labelledby="compare-heading">
  <div class="story-head"><div><p class="section-index">{copy["compare.section-index.1.text0"]}</p><h2 id="compare-heading">{copy["compare.compare-heading.1.text0"]}<br /><em>{copy["compare.em.1.text0"]}</em></h2></div><div class="story-copy"><p>{copy["compare.p.1.text0"]}</p></div></div>
  <div class="compare-toolbar"><p>{copy["compare.p.2.text0"]}</p><label class="compare-picker" for="compare-tool">{copy["compare.compare-picker.1.text0"]}<select id="compare-tool"><option value="obsidian">{copy["compare.option.1.text0"]}</option><option value="notion">{copy["compare.option.2.text0"]}</option><option value="confluence">{copy["compare.option.3.text0"]}</option><option value="gitbook">{copy["compare.option.4.text0"]}</option></select></label><span class="compare-desktop-note">{copy["compare.compare-desktop-note.1.text0"]}</span></div>
  <div class="matrix-shell">
   <table class="fit-matrix"><caption class="visually-hidden">{copy["compare.visually-hidden.1.text0"]}</caption><colgroup><col class="criteria-col" /><col /><col /><col /><col /><col /></colgroup><thead><tr><td><span class="matrix-corner">{copy["compare.matrix-corner.1.text0"]}<br />{copy["compare.matrix-corner.1.text1"]}</span></td><th scope="col" data-tool="hanji"><span class="matrix-brand"><img src="/hanji-mark.svg" alt={copy["compare.img.1.alt"]} />{copy["compare.matrix-brand.1.text1"]}</span><small>{copy["compare.small.1.text0"]}</small></th><th scope="col" data-tool="obsidian" data-active="true">{copy["compare.th.2.text0"]}<small>{copy["compare.small.2.text0"]}</small></th><th scope="col" data-tool="notion">{copy["compare.th.3.text0"]}<small>{copy["compare.small.3.text0"]}</small></th><th scope="col" data-tool="confluence">{copy["compare.th.4.text0"]}<small>{copy["compare.small.4.text0"]}</small></th><th scope="col" data-tool="gitbook">{copy["compare.th.5.text0"]}<small>{copy["compare.small.5.text0"]}</small></th></tr></thead><tbody>
    <tr><th scope="row">{copy["compare.th.6.text0"]}</th><td data-tool="hanji">{copy["compare.td.2.text0"]}</td><td data-tool="obsidian" data-active="true">{copy["compare.td.3.text0"]}</td><td data-tool="notion">{copy["compare.td.4.text0"]}</td><td data-tool="confluence">{copy["compare.td.5.text0"]}</td><td data-tool="gitbook">{copy["compare.td.6.text0"]}</td></tr>
    <tr><th scope="row">{copy["compare.th.7.text0"]}</th><td data-tool="hanji">{copy["compare.td.7.text0"]}</td><td data-tool="obsidian" data-active="true">{copy["compare.td.8.text0"]}</td><td data-tool="notion">{copy["compare.td.9.text0"]}</td><td data-tool="confluence">{copy["compare.td.10.text0"]}</td><td data-tool="gitbook">{copy["compare.td.11.text0"]}</td></tr>
    <tr><th scope="row">{copy["compare.th.8.text0"]}</th><td data-tool="hanji"><strong>{copy["compare.strong.1.text0"]}</strong></td><td data-tool="obsidian" data-active="true">{copy["compare.td.13.text0"]}</td><td data-tool="notion">{copy["compare.td.14.text0"]}</td><td data-tool="confluence">{copy["compare.td.15.text0"]}</td><td data-tool="gitbook">{copy["compare.td.16.text0"]}</td></tr>
    <tr><th scope="row">{copy["compare.th.9.text0"]}</th><td data-tool="hanji">{copy["compare.td.17.text0"]}<small>{copy["compare.small.6.text0"]}</small></td><td data-tool="obsidian" data-active="true">{copy["compare.td.18.text0"]}<small>{copy["compare.small.7.text0"]}</small></td><td data-tool="notion">{copy["compare.td.19.text0"]}<small>{copy["compare.small.8.text0"]}</small></td><td data-tool="confluence">{copy["compare.td.20.text0"]}<small>{copy["compare.small.9.text0"]}</small></td><td data-tool="gitbook">{copy["compare.td.21.text0"]}<small>{copy["compare.small.10.text0"]}</small></td></tr>
    <tr class="matrix-tradeoffs"><th scope="row">{copy["compare.th.10.text0"]}</th><td data-tool="hanji">{copy["compare.td.22.text0"]}<small>{copy["compare.small.11.text0"]}</small></td><td data-tool="obsidian" data-active="true">{copy["compare.td.23.text0"]}<small>{copy["compare.small.12.text0"]}</small></td><td data-tool="notion">{copy["compare.td.24.text0"]}<small>{copy["compare.small.13.text0"]}</small></td><td data-tool="confluence">{copy["compare.td.25.text0"]}<small>{copy["compare.small.14.text0"]}</small></td><td data-tool="gitbook">{copy["compare.td.26.text0"]}<small>{copy["compare.small.15.text0"]}</small></td></tr>
   </tbody></table>
  </div>
  <div class="comparison-bottom"><p>{copy["compare.p.3.text0"]}</p><a class="text-link" href="https://gethanji.github.io/docs/handbook/story/is-hanji-for-you/">{copy["compare.text-link.1.text0"]}</a></div>
  <details class="comparison-sources"><summary>{copy["compare.summary.1.text0"]}<span class="source-date">{copy["compare.source-date.1.text0"]}</span><span class="disclosure" aria-hidden="true"></span></summary><div class="comparison-source-content"><p>{copy["compare.p.4.text0"]}</p><ul><li><strong>{copy["compare.strong.2.text0"]}</strong> <a href="https://gethanji.github.io/docs/handbook/status/">{copy["compare.a.1.text0"]}</a>{copy["compare.li.1.text2"]}<a href="https://gethanji.github.io/docs/handbook/product/two-faces/">{copy["compare.a.2.text0"]}</a></li><li><strong>{copy["compare.strong.3.text0"]}</strong> <a href="https://obsidian.md/help/teams/sync">{copy["compare.a.3.text0"]}</a>{copy["compare.li.2.text2"]}<a href="https://obsidian.md/help/sync/collaborate">{copy["compare.a.4.text0"]}</a></li><li><strong>{copy["compare.strong.4.text0"]}</strong> <a href="https://www.notion.com/help/guides/build-a-docs-first-culture-with-a-beautiful-team-wiki-powered-by-a-database">{copy["compare.a.5.text0"]}</a>{copy["compare.li.3.text2"]}<a href="https://www.notion.com/en-gb/help/export-your-content">{copy["compare.a.6.text0"]}</a>{copy["compare.li.3.text3"]}<a href="https://www.notion.com/help/notion-mcp">{copy["compare.a.7.text0"]}</a></li><li><strong>{copy["compare.strong.5.text0"]}</strong> <a href="https://www.atlassian.com/software/confluence/features">{copy["compare.a.8.text0"]}</a>{copy["compare.li.4.text2"]}<a href="https://support.atlassian.com/confluence-cloud/docs/export-content-to-word-pdf-html-and-xml/">{copy["compare.a.9.text0"]}</a>{copy["compare.li.4.text3"]}<a href="https://www.atlassian.com/platform/rovo-mcp">{copy["compare.a.10.text0"]}</a></li><li><strong>{copy["compare.strong.6.text0"]}</strong> <a href="https://www.gitbook.com/integrations">{copy["compare.a.11.text0"]}</a></li></ul></div></details>
 </section>
