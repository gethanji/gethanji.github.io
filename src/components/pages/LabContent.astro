---
import LinkArrow from '../LinkArrow.astro';
import { dictionary, localHref } from '../../data/site';
import '../../styles/lab-brand.css';
const { lang } = Astro.props;
const copy = dictionary(lang).lab;
---

<section class="hero wrap"><p class="overline">{copy["hero.overline.1.text0"]}</p><h1>{copy["hero.h1.1.text0"]}<br /><em>{copy["hero.em.1.text0"]}</em></h1><p class="lede">{copy["hero.lede.1.text0"]}</p><div class="actions"><a class="button" href="#projects">{copy["hero.button.1.text0"]}</a><a class="button button-quiet" href="#about">{copy["hero.text-link.1.text0"]}</a></div></section>
<section class="paper-story wrap" aria-label={copy["paper-story.paper-story.1.aria-label"]}><div class="paper-sheet sheet-context"><span class="overline">{copy["paper-story.overline.1.text0"]}</span><h2>{copy["paper-story.h2.1.text0"]}<br />{copy["paper-story.h2.1.text1"]}</h2><div class="paper-lines" aria-hidden="true"><i></i><i></i><i></i></div><p>{copy["paper-story.p.1.text0"]}<br />{copy["paper-story.p.1.text1"]}</p><span class="paper-foot">{copy["paper-story.paper-foot.1.text0"]}</span></div><div class="paper-sheet sheet-judgment"><span class="overline">{copy["paper-story.overline.2.text0"]}</span><h2>{copy["paper-story.h2.2.text0"]}<br /><em>{copy["paper-story.em.1.text0"]}</em></h2><div class="paper-mark" aria-hidden="true">{copy["paper-story.paper-mark.1.text0"]}</div><p>{copy["paper-story.p.2.text0"]}<br />{copy["paper-story.p.2.text1"]}</p><span class="paper-foot">{copy["paper-story.paper-foot.2.text0"]}</span></div><div class="paper-sheet sheet-progress"><span class="overline">{copy["paper-story.overline.3.text0"]}</span><h2>{copy["paper-story.h2.3.text0"]}<br />{copy["paper-story.h2.3.text1"]}</h2><div class="paper-path" aria-hidden="true"><i></i><span></span><i></i><span></span><i></i></div><p>{copy["paper-story.p.3.text0"]}<br />{copy["paper-story.p.3.text1"]}</p><span class="paper-foot">{copy["paper-story.paper-foot.3.text0"]}</span></div></section>
<section class="chapter wrap editorial" id="about"><p class="overline">{copy["about.overline.1.text0"]}</p><div><h2>{copy["about.h2.1.text0"]}<br /><em>{copy["about.em.1.text0"]}</em></h2><p>{copy["about.p.1.text0"]}</p><p>{copy["about.p.2.text0"]}</p></div></section>
<section class="chapter wrap" id="projects"><div class="section-head"><div><p class="overline">{copy["projects.overline.1.text0"]}</p><h2>{copy["projects.h2.1.text0"]}<br /><em>{copy["projects.em.1.text0"]}</em></h2></div><p>{copy["projects.p.1.text0"]}</p></div><article class="project project-knowledge"><div><div class="project-meta"><span class="project-number">{copy["projects.project-number.1.text0"]}</span><span class="tag">{copy["projects.tag.1.text0"]}</span></div><h3>{copy["projects.h3.1.text0"]}</h3><p class="project-subhead">{copy["projects.project-subhead.1.text0"]}<br />{copy["projects.project-subhead.1.text1"]}</p><p>{copy["projects.p.2.text0"]}</p><div class="project-actions"><a class="text-link" href={copy["projects.text-link.1.href"]}>{copy["projects.text-link.1.text0"]}<LinkArrow direction="right" /></a><a class="text-link" href={localHref(lang,'/projects/knowledge/#get-started')}>{dictionary(lang).access.cta} <LinkArrow /></a></div></div><a class="product-photo" href={copy["projects.product-photo.1.href"]} aria-label={copy["projects.product-photo.1.aria-label"]}><div class="photo-top"><span><img src="/hanji-mark.svg" alt={copy["projects.img.1.alt"]} />{copy["projects.span.1.text1"]}</span><span>{copy["projects.span.2.text0"]}</span></div><span class="reliable-media"><img src="/assets/reading-view.webp" alt={copy["projects.img.2.alt"]} width="1996" height="1440" loading="lazy" decoding="async" /><span class="media-status"><strong>{copy["projects.strong.1.text0"]}</strong><span>{copy["projects.span.3.text0"]}</span><small data-media-state>{copy["projects.small.1.text0"]}</small></span></span><span class="photo-caption">{copy["projects.photo-caption.1.text0"]}<LinkArrow direction="right" /></span></a></article><article class="project tracker"><div><div class="project-meta"><span class="project-number">{copy["projects.project-number.2.text0"]}</span><span class="tag">{copy["projects.tag.2.text0"]}</span></div><h3>{copy["projects.h3.2.text0"]}</h3><p class="project-subhead">{copy["projects.project-subhead.2.text0"]}<br />{copy["projects.project-subhead.2.text1"]}</p><p>{copy["projects.p.3.text0"]}</p><div class="project-actions"><a class="text-link" href={copy["projects.text-link.2.href"]}>{copy["projects.text-link.2.text0"]}<LinkArrow direction="right" /></a><a class="text-link" href={localHref(lang,'/projects/tracker/#get-started')}>{dictionary(lang).access.cta} <LinkArrow /></a></div></div><a class="product-photo purple-photo" href={copy["projects.product-photo.2.href"]}><div class="photo-top"><span>{copy["projects.span.4.text0"]}</span><span>{copy["projects.span.5.text0"]}</span></div><span class="reliable-media"><img src="/assets/tracker-canvas.webp" width="1440" height="960" loading="lazy" decoding="async" alt={copy["projects.img.3.alt"]} /><span class="media-status"><strong>{copy["projects.strong.2.text0"]}</strong><span>{copy["projects.span.6.text0"]}</span><small data-media-state>{copy["projects.small.2.text0"]}</small></span></span><span class="photo-caption">{copy["projects.photo-caption.2.text0"]}<LinkArrow /></span></a></article></section>
<section class="lab-statement" id="vision"><div class="wrap"><p class="overline">{copy["vision.overline.1.text0"]}</p><h2>{copy["vision.h2.1.text0"]}<br /><em>{copy["vision.em.1.text0"]}</em></h2><div class="statement-bottom"><img src="/hanji-mark.svg" alt={copy["vision.img.1.alt"]} /><div><p>{copy["vision.p.1.text0"]}</p><p>{copy["vision.p.2.text0"]}</p></div></div></div></section>
<section class="chapter wrap origin"><p class="overline">{copy["chapter.overline.2.text0"]}</p><p>{copy["chapter.p.5.text0"]}<br /><em>{copy["chapter.em.2.text0"]}</em></p><div>{copy["chapter.div.2.text0"]}<br /><br />{copy["chapter.div.2.text2"]}<div class="actions"><a class="text-link" href="#projects">{copy["chapter.text-link.1.text0"]}<LinkArrow /></a></div></div></section>

<script>import '../../../public/assets/lab.js';</script>
