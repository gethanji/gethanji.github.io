---
import QuickStart from '../QuickStart.astro';
import { dictionary, localHref } from '../../data/site';
import TrackerHero from '../illustrations/TrackerHero.astro';
const { lang } = Astro.props;
const copy = dictionary(lang).tracker;
---

<section class="hero wrap tracker-hero" aria-labelledby="tracker-title"><p class="overline">{copy["hero.overline.1.text0"]}</p><h1 id="tracker-title">{copy["hero.tracker-title.1.text0"]}<br /><em>{copy["hero.em.1.text0"]}</em></h1><div class="tracker-hero-bottom"><div class="tracker-hero-message"><p class="lede">{copy["hero.lede.1.text0"]}</p><div class="actions"><a class="button" data-quick-start href="#get-started">{dictionary(lang).onboarding.cta}</a><a class="text-link" href="#views">{copy["hero.text-link.1.text0"]}<span aria-hidden="true">{copy["hero.span.1.text0"]}</span></a></div></div><TrackerHero lang={lang} /></div></section><QuickStart lang={lang} product="tracker" /><section class="chapter wrap" id="views"><div class="section-head"><div><p class="overline">{copy["views.overline.1.text0"]}</p><h2>{copy["views.h2.1.text0"]}<br /><em>{copy["views.em.1.text0"]}</em></h2></div><p>{copy["views.p.1.text0"]}</p></div><div class="capture-tabs" role="tablist" aria-label={copy["views.capture-tabs.1.aria-label"]}><button id="capture-canvas" role="tab" aria-selected="true" aria-controls="capture-panel-canvas">{copy["views.capture-canvas.1.text0"]}</button><button id="capture-list" role="tab" aria-selected="false" aria-controls="capture-panel-list" tabindex="-1">{copy["views.capture-list.1.text0"]}</button><button id="capture-board" role="tab" aria-selected="false" aria-controls="capture-panel-board" tabindex="-1">{copy["views.capture-board.1.text0"]}</button></div><figure class="capture" id="capture-panel-canvas" role="tabpanel" aria-labelledby="capture-canvas"><a href="/assets/tracker-canvas.webp" aria-label={copy["views.a.1.aria-label"]}><span class="reliable-media"><img src="/assets/tracker-canvas.webp" width="1440" height="960" alt={copy["views.img.1.alt"]} loading="eager" /><span class="media-status"><strong>{copy["views.strong.1.text0"]}</strong><span>{copy["views.span.1.text0"]}</span><small data-media-state>{copy["views.small.1.text0"]}</small></span></span></a><figcaption><span>{copy["views.span.2.text0"]}</span><span>{copy["views.span.3.text0"]}</span></figcaption></figure><figure class="capture" id="capture-panel-list" role="tabpanel" aria-labelledby="capture-list" hidden><a href="/assets/tracker-list.webp" aria-label={copy["views.a.2.aria-label"]}><span class="reliable-media"><img src="/assets/tracker-list.webp" width="1440" height="960" alt={copy["views.img.2.alt"]} loading="eager" /><span class="media-status"><strong>{copy["views.strong.2.text0"]}</strong><span>{copy["views.span.4.text0"]}</span><small data-media-state>{copy["views.small.2.text0"]}</small></span></span></a><figcaption><span>{copy["views.span.5.text0"]}</span><span>{copy["views.span.6.text0"]}</span></figcaption></figure><figure class="capture" id="capture-panel-board" role="tabpanel" aria-labelledby="capture-board" hidden><a href="/assets/tracker-board.webp" aria-label={copy["views.a.3.aria-label"]}><span class="reliable-media"><img src="/assets/tracker-board.webp" width="1440" height="960" alt={copy["views.img.3.alt"]} loading="eager" /><span class="media-status"><strong>{copy["views.strong.3.text0"]}</strong><span>{copy["views.span.7.text0"]}</span><small data-media-state>{copy["views.small.3.text0"]}</small></span></span></a><figcaption><span>{copy["views.span.8.text0"]}</span><span>{copy["views.span.9.text0"]}</span></figcaption></figure><div class="feature-pair"><div><h3>{copy["views.h3.1.text0"]}</h3><p>{copy["views.p.2.text0"]}</p></div><div><h3>{copy["views.h3.2.text0"]}</h3><p>{copy["views.p.3.text0"]}</p></div></div></section>
<section class="chapter wrap product-chapter"><div><p class="overline">{copy["chapter.overline.1.text0"]}</p><h2>{copy["chapter.h2.1.text0"]}<br /><em>{copy["chapter.em.1.text0"]}</em></h2><p>{copy["chapter.p.1.text0"]}</p><p>{copy["chapter.p.2.text0"]}</p><p class="quiet-note">{copy["chapter.quiet-note.1.text0"]}</p></div><figure class="capture capture-detail"><a href="/assets/tracker-issue.webp" aria-label={copy["chapter.a.1.aria-label"]}><span class="reliable-media"><img src="/assets/tracker-issue.webp" width="1440" height="960" alt={copy["chapter.img.1.alt"]} loading="eager" /><span class="media-status"><strong>{copy["chapter.strong.1.text0"]}</strong><span>{copy["chapter.span.1.text0"]}</span><small data-media-state>{copy["chapter.small.1.text0"]}</small></span></span></a><figcaption>{copy["chapter.figcaption.1.text0"]}</figcaption></figure></section>
<section class="chapter wrap" id="direction"><div class="section-head"><div><p class="overline">{copy["direction.overline.1.text0"]}</p><h2>{copy["direction.h2.1.text0"]}<br /><em>{copy["direction.em.1.text0"]}</em></h2></div><p>{copy["direction.p.1.text0"]}</p></div><figure class="capture"><a href="/assets/tracker-objectives.webp" aria-label={copy["direction.a.1.aria-label"]}><span class="reliable-media"><img src="/assets/tracker-objectives.webp" width="1440" height="620" alt={copy["direction.img.1.alt"]} loading="eager" /><span class="media-status"><strong>{copy["direction.strong.1.text0"]}</strong><span>{copy["direction.span.1.text0"]}</span><small data-media-state>{copy["direction.small.1.text0"]}</small></span></span></a><figcaption><span>{copy["direction.span.2.text0"]}</span><span>{copy["direction.span.3.text0"]}</span></figcaption></figure><div class="feature-pair"><div><h3>{copy["direction.h3.1.text0"]}</h3><p>{copy["direction.p.2.text0"]}</p></div><div><h3>{copy["direction.h3.2.text0"]}</h3><p>{copy["direction.p.3.text0"]}</p></div></div></section>
<section class="tracker-foundation"><div class="wrap foundation-inner"><div><p class="overline">{copy["tracker-foundation.overline.1.text0"]}</p><h2>{copy["tracker-foundation.h2.1.text0"]}<br />{copy["tracker-foundation.h2.1.text1"]}<br /><em>{copy["tracker-foundation.em.1.text0"]}</em></h2></div><div><p>{copy["tracker-foundation.p.1.text0"]}</p><p>{copy["tracker-foundation.p.2.text0"]}</p><pre aria-label={copy["tracker-foundation.pre.1.aria-label"]}>{copy["tracker-foundation.pre.1.text0"]}</pre></div></div></section>
<section class="chapter wrap more-tools"><div class="section-head"><div><p class="overline">{copy["chapter.overline.2.text0"]}</p><h2>{copy["chapter.h2.2.text0"]}<br /><em>{copy["chapter.em.2.text0"]}</em></h2></div><p>{copy["chapter.p.3.text0"]}</p></div><details open><summary>{copy["chapter.summary.1.text0"]}</summary><p>{copy["chapter.p.4.text0"]}</p></details><details><summary>{copy["chapter.summary.2.text0"]}</summary><p>{copy["chapter.p.5.text0"]}</p></details><details><summary>{copy["chapter.summary.3.text0"]}</summary><p>{copy["chapter.p.6.text0"]}</p></details><details><summary>{copy["chapter.summary.4.text0"]}</summary><p>{copy["chapter.p.7.text0"]}</p></details></section>
<section class="chapter wrap status" id="status"><div><p class="overline">{copy["status.overline.1.text0"]}</p><h2>{copy["status.h2.1.text0"]}<br /><em>{copy["status.em.1.text0"]}</em></h2></div><div><p>{copy["status.p.1.text0"]}</p><p>{copy["status.p.2.text0"]}</p><a class="text-link" href="#get-started">{dictionary(lang).access.cta}<span aria-hidden="true">{copy["status.span.1.text0"]}</span></a></div></section><section class="chapter wrap next-project"><div><p class="overline">{copy["chapter.overline.3.text0"]}</p><h2>{copy["chapter.h2.3.text0"]}<br /><em>{copy["chapter.em.3.text0"]}</em></h2></div><a class="button" href={copy["chapter.button.1.href"]}>{copy["chapter.button.1.text0"]}</a></section>
