---
import { dictionary, projects, route } from '../data/site';
import LanguagePicker from './LanguagePicker.astro';
import ThemePicker from './ThemePicker.astro';
const { lang, page } = Astro.props;
const ui = dictionary(lang).ui;
---
<header class="family-nav site-header">
  <div class="family-inner">
    <a class="family-brand" href={route(lang,'lab')} aria-label={ui.homeLabel}><span><img src="/hanji-mark.svg" alt="" /></span><b class="brand-name">Hanji</b></a>
    <nav class="family-shortcuts" aria-label={ui.shortcuts}>
      {projects.map(p => <a href={route(lang,p.id)} aria-current={page === p.id ? 'page' : undefined}>{p.name}</a>)}
    </nav>
    <div class="family-right">
      <LanguagePicker lang={lang} page={page} />
      <ThemePicker lang={lang} />
    </div>
  </div>
</header>
<script>
  import '../scripts/site-chrome';
  import '../scripts/language';
</script>
