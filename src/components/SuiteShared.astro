---
import {dictionary} from '../data/site';import LinkArrow from './LinkArrow.astro';
const {lang}=Astro.props,copy=dictionary(lang).suite;
const principles=[{title:copy.conductorTitle,text:copy.conductorText,path:'guide/conductor'},{title:copy.ownershipTitle,text:copy.ownershipText,path:'story/why-hanji-is-different'},{title:copy.agencyTitle,text:copy.agencyText,path:'product/permissions'}];
---
<section class="suite-foundation wrap" id="about" aria-labelledby="foundation-heading">
 <div class="section-head"><h2 id="foundation-heading">{copy.sharedTitle}</h2><p>{copy.sharedText}</p></div>
 <div class="suite-principles">{principles.map((principle,i)=><article><span class="overline">0{i+1}</span><h3>{principle.title}</h3><p>{principle.text}</p><a class="text-link" href={`https://hanji.ink/docs/handbook/${principle.path}/`}>{copy.handbook} <LinkArrow /></a></article>)}</div>
</section>
<aside class="suite-preview wrap" id="setup"><div><h2>{copy.setupTitle}</h2><p>{copy.setupText}</p></div><a class="text-link" href="/start/">{copy.setup} <LinkArrow /></a></aside>
