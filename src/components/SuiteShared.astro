---
import {dictionary} from '../data/site';import LinkArrow from './LinkArrow.astro';
const {lang}=Astro.props,copy=dictionary(lang).suite;
---
<section class="suite-shared wrap" id="about"><div class="section-head"><div><p class="overline">Hanji</p><h2>{copy.sharedTitle}</h2></div><p>{copy.sharedText}</p></div>
 <article class="suite-shared-story"><div><span class="overline">01 · Conductor</span><h3>{copy.conductorTitle}</h3><p>{copy.conductorText}</p><a class="text-link" href="https://hanji.ink/docs/handbook/guide/conductor/">{copy.handbook} <LinkArrow /></a></div><figure><img src="/assets/current/preview-conductor.webp" width="680" height="461" alt={copy.conductorTitle} loading="lazy" decoding="async"/><figcaption>{copy.captureNote}</figcaption></figure></article>
 <article class="suite-shared-story reverse"><div><span class="overline">02 · Activity</span><h3>{copy.insightsTitle}</h3><p>{copy.insightsText}</p><a class="text-link" href="https://hanji.ink/docs/handbook/guide/activity/">{copy.handbook} <LinkArrow /></a></div><figure><img src="/assets/current/preview-insights.webp" width="1440" height="1000" alt={copy.insightsTitle} loading="lazy" decoding="async"/><figcaption>{copy.captureNote}</figcaption></figure></article>
</section>
<section class="suite-onboarding wrap" id="setup"><div><p class="overline">{copy.previewLabel}</p><h2>{copy.onboardingTitle}</h2><p>{copy.onboardingText}</p><ol>{copy.steps.map((step,i)=><li><span>0{i+1}</span>{step}</li>)}</ol><a class="text-link" href="/start/">{copy.setup} <LinkArrow /></a></div><figure><img src="/assets/current/preview-onboarding.webp" width="1280" height="900" alt={copy.onboardingTitle} loading="lazy" decoding="async"/><figcaption>{copy.captureNote}</figcaption></figure></section>
