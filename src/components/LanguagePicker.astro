---
import { locales, languages, route, dictionary } from '../data/site';
const { lang, page } = Astro.props;
const ui = dictionary(lang).ui;
---
<details class="picker lang-picker ui-disclosure" data-disclosure data-page={page}>
  <summary class="ui-control icon-control" title={ui.language} aria-label={ui.language}>
    <svg class="setting-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.5"/><ellipse cx="10" cy="10" rx="3.5" ry="7.5"/><path d="M2.5 10h15"/></svg>
  </summary>
  <div class="lang-menu ui-disclosure-panel">
    <a class="lang-option is-current" data-language="system" href={route(lang,page)} aria-current="true">{ui.theme.system}<i aria-hidden="true">✓</i></a>
    {locales.map(code => <a class="lang-option" data-language={code} href={route(code,page)} lang={code} hreflang={code}>{languages[code]}<i aria-hidden="true">✓</i></a>)}
  </div>
</details>
