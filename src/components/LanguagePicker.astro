---
import Chevron from './Chevron.astro';
import { locales, languages, route, dictionary } from '../data/site';
const { lang, page } = Astro.props;
const ui = dictionary(lang).ui;
---
<div class="family-language">
  <details class="picker lang-picker ui-disclosure" data-disclosure>
    <summary class="ui-control" title={ui.language} aria-label={ui.language}>
      <svg class="language-globe" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.5"/><ellipse cx="10" cy="10" rx="3.5" ry="7.5"/><path d="M2.5 10h15"/></svg>
      <span lang={lang}>{languages[lang]}</span><Chevron />
    </summary>
    <div class="lang-menu ui-disclosure-panel">
      {locales.map(code => code === lang
        ? <span class="lang-option is-current" lang={code} aria-current="true">{languages[code]}<i>✓</i></span>
        : <a class="lang-option" href={route(code, page)} lang={code} hreflang={code}>{languages[code]}<i>{code.toUpperCase()}</i></a>)}
    </div>
  </details>
</div>
