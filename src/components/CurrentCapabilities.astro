---
import {dictionary} from '../data/site';
import {captures} from '../data/captures';
import LinkArrow from './LinkArrow.astro';
import ProductExample from './ProductExample.astro';
const {lang,product}=Astro.props,copy=dictionary(lang).suite,capture=captures[product],example=copy.examples[product];
---
<section class:list={['current-capabilities',product==='knowledge'?'chapter':'chapter wrap']} data-current-capabilities aria-labelledby={`current-${product}`}>
 <div class="section-head"><div><p class="overline">{capture.name} · {copy.examples.labels.kicker}</p><h2 id={`current-${product}`}>{example.title}</h2></div><p>{example.summary}</p></div>
 <ProductExample lang={lang} product={product}/>
 <figure class="current-capture"><a href={capture.src}><img src={capture.src} width={capture.width} height={capture.height} alt={`${capture.name} — ${example.outcome}`} loading="lazy" decoding="async" /></a><figcaption>{copy.examples.labels.note}</figcaption></figure>
 <ul class="current-feature-list">{copy.features[product].map(text=><li>{text}</li>)}</ul>
 <a class="text-link" href={`https://hanji.ink/docs/handbook/guide/${product==='think'?'whiteboard':product==='tracker'?'planning-work':'reading-and-writing'}/`}>{copy.handbook} <LinkArrow /></a>
</section>
