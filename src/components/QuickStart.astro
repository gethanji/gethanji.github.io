---
import LinkArrow from './LinkArrow.astro';
import AccessForm from './AccessForm.astro';
import {dictionary} from '../data/site';
import '../styles/quick-start.css';
const {lang,product}=Astro.props;
const t=dictionary(lang).onboarding,c=t[product as 'knowledge'|'tracker'|'think'];
const access=dictionary(lang).access;
const command=product==='knowledge'?'pnpm install\npnpm dev:web':`pnpm install
pnpm tracker init ../fieldnotes --name Fieldnotes --prefix LAB --owner ada
export TRACKER_WORKSPACE="$(cd ../fieldnotes && pwd)"
pnpm tracker project new fieldnotes --title Fieldnotes
pnpm tracker new "Draft the invitation" --project fieldnotes
pnpm dev:tracker-web`;
---
<section id="get-started" class:list={['quick-start','chapter',product!=='knowledge'&&'wrap']} aria-labelledby="quick-start-title" tabindex="-1">
 <p class="quick-start-eyebrow">{t.cta}</p><h2 id="quick-start-title">{t.title}</h2>
 <p class="quick-start-availability">{c.availability}</p>
 <AccessForm lang={lang} product={product} />
 <a class="text-link" href={product==='think'?'https://hanji.ink/docs/handbook/guide/whiteboard/':'https://hanji.ink/docs/'}>{c.now} <LinkArrow /></a>
 <a class="text-link" href="/start/">{{en:"Desktop setup guide",ko:"데스크톱 설정 가이드 (영어)",de:"Desktop-Einrichtung (Englisch)",ja:"デスクトップ設定ガイド（英語）",fr:"Guide de configuration (anglais)"}[lang]} <LinkArrow /></a>
 <details class="setup-notes"><summary>{access.setup}</summary>
 <ol class="quick-start-steps">
  {[c.prerequisites,c.setup,c.outcome,c.agent].map((text,i)=><li><h3><span aria-hidden="true">0{i+1}</span>{t.heads[i]}</h3><p>{text}</p>{i===1&&<pre><code>{product==='think'?'node scripts/whiteboard-build.mjs\nnode --import tsx packages/whiteboard/src/main.ts --port 4104':command}</code></pre>}</li>)}
 </ol>
 <a class="text-link" href={product==='think'?'https://hanji.ink/docs/handbook/guide/whiteboard/':product==='knowledge'?'#run':'#status'}>{c.next} <LinkArrow /></a>
 </details>
</section>
