---
import {dictionary} from '../../data/site';
import StoryControls from './StoryControls.astro';
import '../../styles/knowledge-motion.css';
const {copy,lang} = Astro.props;
const story=dictionary(lang).story;
const controls={...story,steps:story.knowledgeSteps};
---
<figure class="mini-hanji" aria-label={copy["hero.mini-hanji.1.aria-label"]}><div class="mini-window" aria-hidden="true"><div class="mini-chrome"><span class="mini-brand"><img src="/hanji-mark.svg" alt={copy["hero.img.1.alt"]} />{copy["hero.mini-brand.1.text1"]}</span><span class="mini-presence"><i>{copy["hero.i.1.text0"]}</i><i>{copy["hero.i.2.text0"]}</i><i>{copy["hero.i.3.text0"]}</i></span></div><div class="mini-body"><aside class="mini-nav"></aside><div class="mini-paper"><div class="mini-crumb">{copy["hero.mini-crumb.1.text0"]}</div><h3>{copy["hero.h3.1.text0"]}</h3><div class="mini-rule rule-long"></div><div class="mini-rule rule-short"></div><div class="mini-edits"><p class="mini-written line-one">{copy["hero.mini-written.1.text0"]}</p><p class="mini-written line-two">{copy["hero.mini-written.2.text0"]}</p></div><div class="mini-proposed"><div class="mini-add add-one">{copy["hero.mini-add.1.text0"]}<i>{copy["hero.i.4.text0"]}</i></div><div class="mini-add add-two">{copy["hero.mini-add.2.text0"]}<i>{copy["hero.i.5.text0"]}</i></div></div><div class="mini-review-bar"><span class="mini-reviewed">{copy["hero.mini-reviewed.1.text0"]}</span><span class="mini-merge"><span class="merge-before">{copy["hero.merge-before.1.text0"]}</span><span class="merge-after">{copy["hero.merge-after.1.text0"]}</span></span></div></div></div><div class="mini-cursor cursor-ada"><svg viewbox="0 0 18 22" aria-hidden="true"><path d="M2 2 15 13 9 14 6 20Z" fill="currentColor" stroke="white" stroke-width="1.5" stroke-linejoin="round"></path></svg><span>{copy["hero.span.2.text0"]}<small>{copy["hero.small.1.text0"]}</small></span></div><div class="mini-cursor cursor-claude"><svg viewbox="0 0 18 22" aria-hidden="true"><path d="M2 2 15 13 9 14 6 20Z" fill="currentColor" stroke="white" stroke-width="1.5" stroke-linejoin="round"></path></svg><span>{copy["hero.span.3.text0"]}<small>{copy["hero.small.2.text0"]}</small></span></div><div class="mini-cursor cursor-codex"><svg viewbox="0 0 18 22" aria-hidden="true"><path d="M2 2 15 13 9 14 6 20Z" fill="currentColor" stroke="white" stroke-width="1.5" stroke-linejoin="round"></path></svg><span>{copy["hero.span.4.text0"]}<small>{copy["hero.small.3.text0"]}</small></span></div></div><figcaption class="knowledge-story-controls"><StoryControls copy={controls} frames={[0,1,2,3,4]}/></figcaption><script type="application/json" data-knowledge-controls set:html={JSON.stringify(controls).replaceAll('<','\\u003c')}></script></figure>
<script>import '../../scripts/knowledge-story';</script>
