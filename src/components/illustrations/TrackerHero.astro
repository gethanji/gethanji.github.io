---
import {dictionary} from '../../data/site';
import StoryControls from './StoryControls.astro';
const {lang} = Astro.props;
const t=dictionary(lang).story,c=t.canvasHero;
const tasks=[{title:c.outline,ask:c.ask2,reply:c.reply2},{title:c.invitation,ask:c.ask0,reply:c.reply0},{title:c.feedback,ask:c.ask1,reply:c.reply1},{title:c.publish,ask:c.ask3,reply:c.reply3}];
---
<figure class="tracker-mini illustration" id="canvas" data-stage="done" data-focus="canvas" aria-label={c.label}>
 <script type="application/json" data-story-copy set:html={JSON.stringify(t).replaceAll('<','\\u003c')}></script>
 <div class="tracker-mini-window">
  <div class="tm-conductor-chat" aria-label={c.conductor}>
   <header><img src="/hanji-mark.svg" alt=""/><span>{c.conductor}</span><i aria-hidden="true">✳</i></header>
   <div class="tm-user-message"><small>Ada</small><p>{c.request}</p></div>
   <div class="tm-conductor-reply"><small>{c.conductor}</small><p>{c.response}</p></div>
  </div>
  <div class="tm-canvas">
   <div class="tm-chrome"><span><img src="/hanji-mark.svg" alt=""/>Tracker</span><span>{t.canvas}</span></div>
   <div class="tm-project">
    <div class="tm-project-label"><span>Fieldnotes</span><small>Fieldnotes / 01</small></div>
    <svg class="tm-flow" viewBox="0 0 500 170" preserveAspectRatio="none" aria-hidden="true"><defs><marker id="flow-arrow" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="5" markerHeight="5" orient="auto"><path d="M1 1 L6 4 L1 7"/></marker></defs>{[[0,1],[0,2],[1,3],[2,3]].map(([a,b])=><path class="tm-flow-edge" data-from={a} data-to={b} marker-end="url(#flow-arrow)"/>)}</svg>
    <div class="tm-task-cards">{tasks.map((task,i)=><button type="button" class="tm-card" data-card={i} data-state="review" data-reviewed={String(i===1)} aria-expanded={i===1} aria-controls={`task-chat-${i}`} disabled><small><span class="tm-node-dot"></span>0{i+1}<span class="tm-card-check" aria-hidden="true">✓</span></small><b>{task.title}</b><span class="tm-card-result">{c.result}</span></button>)}</div>
    {['Claude','Codex','Ada'].map((name,i)=><span class:list={['tm-pointer',i===2?'tm-cursor':`tm-builder tm-builder-${i}`]} aria-hidden="true"><svg viewBox="0 0 18 22"><path d="M2 2 15 13 9 14 6 20Z" fill="currentColor" stroke="white" stroke-width="1.5" stroke-linejoin="round"/></svg><span>{name}</span></span>)}
   </div>
  </div>
  <svg class="tm-links" aria-hidden="true"><path/></svg>
  <div class="tm-chat-slot">
   {tasks.map((task,i)=><section class="tm-task-chat" id={`task-chat-${i}`} data-task-chat={i} hidden={i!==1} aria-labelledby={`task-chat-title-${i}`}>
    <header><h3 id={`task-chat-title-${i}`} tabindex="-1">LAB-{i+1} · {task.title}</h3><button type="button" data-close-task aria-label={c.close}>×</button></header>
    <div class="tm-task-ask"><small>Ada</small><p>{task.ask}</p></div>
    <div class="tm-task-reply"><small>Claude ✳</small><p>“{task.reply}”</p><span class="tm-complete">✓ {c.result}</span></div>
   </section>)}
  </div>
 </div>
 <figcaption><span>{c.caption}<small>{c.label}</small></span><StoryControls copy={t}/></figcaption>
 <ol class="illustration-summary">{t.story.map(line=><li>{line}</li>)}</ol>
</figure>
<script>import '../../scripts/tracker-story';</script>
